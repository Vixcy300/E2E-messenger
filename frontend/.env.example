# SDCMS Frontend Environment Configuration
# ─────────────────────────────────────────
# Copy this file to .env.local for local dev, or set in Vercel/Render dashboard

# Backend API URL
# Local development (default if not set):
#   http://localhost:8080/api
#
# Production on Render — replace with your Render service URL:
VITE_API_URL=https://sdcms-backend.onrender.com/api
